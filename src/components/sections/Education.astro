			</div>

			<!-- Item 4 -->
			<div class="flex flex-col items-center justify-center gap-[6px] md:mt-[29px] md:items-baseline mx-auto w/full max-w-[520px]">
				<p class="font-dmserif text-[1.1rem] text-[#110F06] md:text-left">AWS Partner: Technical Accredited - Training Badge</p>
				<div>
					<p class="max-w-[520px] font-matter text-[0.8rem] text-[#110F06] md:max-w-[500px] md:text-[.8rem]">Amazon Web Services</p>
					<p class="mt-[6px] max-w-[520px] font-matter text-[0.8rem] italic text-[#110F06] md:max-w-[500px] md:text-start md:text-[.7rem]">Jul/2025</p>
				</div>
				<a href="https://www.credly.com/badges/df140bd7-9741-418a-a0b9-527cad705f87/public_url" target="_blank" class="inline-block mx-auto md:mx-0 font-matter text-[0.8rem] text-[#2F2A16] underline hover:text-[#110F06] transition-all">Ver no Credly</a>
