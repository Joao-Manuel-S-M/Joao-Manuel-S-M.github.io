			<!-- Item 3 -->
			<div class="flex flex-col items-center justify-center gap-[6px] md:mt-[29px] md:text-left md:items-baseline mx-auto w/full max-w-[520px]">
				<p class=" md:text-left font-dmserif text-[1.1rem] text-[#110F06]">AWS Partner: Sales Accreditation - Training Badge</p>
				<div>
					<p class="max-w-[520px] font-matter text-[0.8rem] text-[#110F06] md:max-w-[500px] md:text-[.8rem]">Amazon Web Services</p>
