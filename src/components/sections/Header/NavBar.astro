</style>

<style>
	/* <reset-style> ============================ */
	a {
		text-decoration: none;
	}
	/* <main-style> ============================ */
	.menu__link {
		color: #372f2f;
		line-height: 2;
		position: relative;
	}

	.menu__link::before {
		content: "";
		width: 0;
		height: 1.5px;
		border-radius: 2px;
		background-color: #372f2f;
		position: absolute;
		bottom: 2px;
		right: 0;
		transition:
			right 0.4s,
			width 0.4s,
			left 0.4s;
	}

	.menu__link:hover::before,
	input[type="radio"]:checked + .menu__link::before {
		width: 100%;
		left: 0;
	}
</style>

<script>
	function toSections() {
		const labels = [
			"casa home",
			"sobre about",
			"projetos projects",
			"tecnologias skills",
			"cv education",
			"number contact",
		];
		labels.forEach((label) => {
			const getLabel = document.querySelector(
				`label[for="${label.split(" ")[0]}"]`
			);

			getLabel?.addEventListener("click", () => {
				const targetElement = document.getElementById(label.split(" ")[1]);
				if (targetElement) {
					// @ts-ignore
					const scrollbar = Scrollbar.get(
						document.querySelector("#smooth-content")
					);
					const targetPosition =
						targetElement.getBoundingClientRect().top + scrollbar.scrollTop;
					scrollbar.scrollTo(0, targetPosition - 90, 1000); // 1000ms para smooth scroll
				}
			});
		});
	}

 	function checkSectionInView() {
 		const mappings = [
 			{ id: 'casa', section: 'home' },
 			{ id: 'sobre', section: 'about' },
 			{ id: 'projetos', section: 'projects' },
 			{ id: 'tecnologias', section: 'skills' },
 			// 'cv' should be active when either 'education' OR 'certifications' is visible
 			{ id: 'cv', section: ['education', 'certifications'] },
 			{ id: 'number', section: 'contact' },
 		];

 		// @ts-ignore
 		const scrollbar = Scrollbar.get(document.querySelector('#smooth-content'));
 		if (!scrollbar) return;

 		const viewportTop = scrollbar.scrollTop;
 		const viewportHeight = scrollbar.getSize().container.height;

 		mappings.forEach(({ id, section }) => {
 			const checkbox = document.querySelector(`input[id="${id}"]`);
 			if (!checkbox) return;

 			let isVisible = false;

 			if (Array.isArray(section)) {
 				// if any of the sections in the array is visible, mark the checkbox
 				for (const sec of section) {
 					const el = document.getElementById(sec);
 					if (!el) continue;
 					const elTop = el.getBoundingClientRect().top + viewportTop;
 					const elBottom = elTop + el.offsetHeight;
 					if (elBottom > viewportTop && elTop < viewportTop + viewportHeight) {
 						isVisible = true;
 						break;
 					}
 				}
 			} else {
 				const el = document.getElementById(section);
 				if (el) {
 					const elTop = el.getBoundingClientRect().top + viewportTop;
 					const elBottom = elTop + el.offsetHeight;
 					isVisible = elBottom > viewportTop && elTop < viewportTop + viewportHeight;
 				}
 			}

 			(checkbox as HTMLInputElement).checked = !!isVisible;
 		});
 	}



	
	// Inicializa o smooth-scrollbar se necessário
	// @ts-ignore
	const isLargeScreen = window.innerWidth > 800;
	if (isLargeScreen) {
		// @ts-ignore
		const scrollbar = Scrollbar.init(document.querySelector("#smooth-content"));
		scrollbar.addListener(
			({ offset }: { offset: { x: number; y: number } }) => {
				if (offset.x !== 0) {
					scrollbar.setPosition(0, offset.y, { withoutCallbacks: true });
				}
			}
		);
		// Adiciona o evento de rolagem ao smooth-scrollbar
		scrollbar.addListener(checkSectionInView);
	}

	//desabilita o scroll

	toSections();
</script>
